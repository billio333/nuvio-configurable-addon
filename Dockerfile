FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY server.cjs provider-worker.cjs config-page.cjs pool.cjs pool.test.cjs source-policy.cjs castle-guards.cjs quality.test.cjs source-health.cjs health-panel.cjs health.test.cjs preferences.test.cjs source-tester.cjs tester.test.cjs movy.cjs movy.test.cjs install-movy.cjs cno-probe.cjs cno-probe.test.cjs cno.cjs cno.test.cjs install-cno.cjs ./
RUN node install-movy.cjs && node install-cno.cjs && node cno-probe.cjs && npm run check && node --check config-page.cjs && node --check source-policy.cjs && node --check castle-guards.cjs && node --check source-health.cjs && node --check source-tester.cjs && node --check movy.cjs && node --check cno-probe.cjs && node --check cno.cjs && node pool.test.cjs && node quality.test.cjs && node health.test.cjs && node preferences.test.cjs && node tester.test.cjs && node movy.test.cjs && node cno-probe.test.cjs && node cno.test.cjs
USER node
ENV PORT=7000
EXPOSE 7000
CMD ["node","-e","require('./server.cjs');(async()=>{const base='https://pressplayz.top';const url=base+'/watch/tv-family-guy-fjboc?season=22&episode=1';const get=async u=>{const r=await fetch(u,{signal:AbortSignal.timeout(10000)});return {status:r.status,text:await r.text()};};const clean=(v,b=url)=>{try{const u=new URL(v,b);return /^https?:$/.test(u.protocol)?u.origin+u.pathname:null;}catch{return null;}};const decode=v=>{if(Array.isArray(v)&&v.length===2&&typeof v[0]==='number'){if(v[0]===0)return decode(v[1]);if(v[0]===1)return Array.isArray(v[1])?v[1].map(decode):v[1];return '[type '+v[0]+']';}if(v&&typeof v==='object'&&!Array.isArray(v))return Object.fromEntries(Object.entries(v).map(([k,x])=>[k,decode(x)]));return v;};const safe=(v,d=0)=>{if(d>4)return '[depth limit]';if(typeof v==='string')return /^https?:/i.test(v)?clean(v):v.slice(0,200);if(Array.isArray(v))return v.slice(0,15).map(x=>safe(x,d+1));if(v&&typeof v==='object')return Object.fromEntries(Object.entries(v).filter(([k])=>!/token|secret|password|cookie|auth|user|key/i.test(k)).slice(0,25).map(([k,x])=>[k,safe(x,d+1)]));return v;};const page=await get(url);const $=require('cheerio').load(page.text);const island=$('astro-island[component-export=TVShowPlayer]').first();const props=decode(JSON.parse(island.attr('props')||'{}'));const settings=Object.fromEntries(['currentSourceName','currentSourceId','currentSourceTvUrl','activeServerConfig'].map(k=>[k,safe(props[k])]));const component=clean(island.attr('component-url'));let player={};if(component&&new URL(component).origin===base){try{const js=await get(component);player={status:js.status,apiPaths:[...new Set(js.text.match(new RegExp('/api/[A-Za-z0-9_./-]+','g'))||[])].slice(0,30)};}catch(e){player={error:e.name};}}let embed={};try{const target='https://moviesapi.to/tv/1434-22-1';const r=await get(target);const e=require('cheerio').load(r.text);embed={status:r.status,challengeDetected:/just a moment|challenge-platform|cf-chl-/i.test(r.text),frames:e('iframe[src]').map((i,n)=>clean(e(n).attr('src'),target)).get().slice(0,10),scripts:e('script[src]').map((i,n)=>clean(e(n).attr('src'),target)).get().slice(0,15),playlistMarkerFound:r.text.toLowerCase().includes('.m3u8')};}catch(e){embed={error:e.name};}console.log(JSON.stringify({event:'pressplay_player_probe',pageStatus:page.status,settings,player,embed}));})().catch(e=>console.log(JSON.stringify({event:'pressplay_player_probe_failed',error:e.name})));" ]
