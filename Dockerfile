FROM node:22-alpine
WORKDIR /app
COPY package.json ./
RUN apk add --no-cache chromium && npm install --omit=dev --ignore-scripts && npm install --no-save --omit=dev --ignore-scripts playwright-core
COPY server.cjs provider-worker.cjs config-page.cjs pool.cjs pool.test.cjs source-policy.cjs castle-guards.cjs quality.test.cjs source-health.cjs health-panel.cjs health.test.cjs preferences.test.cjs source-tester.cjs tester.test.cjs movy.cjs movy.test.cjs install-movy.cjs cno-probe.cjs cno-probe.test.cjs cno.cjs cno.test.cjs install-cno.cjs ./
RUN node install-movy.cjs && node install-cno.cjs && node cno-probe.cjs && npm run check && node --check config-page.cjs && node --check source-policy.cjs && node --check castle-guards.cjs && node --check source-health.cjs && node --check source-tester.cjs && node --check movy.cjs && node --check cno-probe.cjs && node --check cno.cjs && node pool.test.cjs && node quality.test.cjs && node health.test.cjs && node preferences.test.cjs && node tester.test.cjs && node movy.test.cjs && node cno-probe.test.cjs && node cno.test.cjs
USER node
ENV PORT=7000
EXPOSE 7000
CMD ["node","-e","require('./server.cjs');(async()=>{let browser,stage='launch';const started=Date.now();const output=x=>console.log(JSON.stringify({event:'pressplay_extraction_test',milliseconds:Date.now()-started,...x}));try{browser=await require('playwright-core').chromium.launch({executablePath:'/usr/bin/chromium',headless:true,timeout:15000,args:['--no-sandbox','--disable-dev-shm-usage','--autoplay-policy=no-user-gesture-required']});const context=await browser.newContext();const page=await context.newPage();context.on('page',p=>{if(p!==page)p.close().catch(()=>{});});await context.route('**/*',route=>{const r=route.request();const u=r.url();if(['image','font','media'].includes(r.resourceType())&&!u.includes('.m3u8'))return route.abort();if(u.includes('anemonytahua.com')||u.includes('tectrixsnavvle.com'))return route.abort();return route.continue();});stage='waiting_for_playlist';const pending=page.waitForResponse(r=>r.url().includes('.m3u8')||/mpegurl/i.test(r.headers()['content-type']||''),{timeout:30000}).then(r=>r,()=>null);await page.goto('https://moviesapi.to/tv/1434-22-1?autoPlay=true&poster=false',{waitUntil:'domcontentloaded',timeout:15000,referer:'https://pressplayz.top/'}).catch(()=>{});const response=await pending;if(!response){output({stage,playlistFound:false,pageTitle:(await page.title().catch(()=>'' )).slice(0,120)});return;}const url=response.url();stage='checking_playlist_outside_browser';const headers=await response.request().allHeaders();for(const k of ['host','connection','content-length','accept-encoding'])delete headers[k];const cookies=await context.cookies(url);if(cookies.length)headers.cookie=cookies.map(c=>c.name+'='+c.value).join('; ');const r=await fetch(url,{headers,signal:AbortSignal.timeout(10000)});const text=await r.text();output({stage,playlistFound:true,browserStatus:response.status(),playlistHost:new URL(url).hostname,serverFetchStatus:r.status,isHls:text.trimStart().startsWith('#EXTM3U'),hasVariants:text.includes('#EXT-X-STREAM-INF'),hasMediaSegments:text.includes('#EXTINF'),requiresCapturedCookies:cookies.length>0});}catch(e){output({stage,error:e.name});}finally{if(browser)await browser.close().catch(()=>{});}})();" ]
